<Window x:Class="Deszyfrowanie_Logów.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deszyfrowanie Logów"
        Height="800"
        Width="1150"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#15191F"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="WindowBackground" Color="#15191F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E242D"/>
        <SolidColorBrush x:Key="InputBackground" Color="#171D25"/>
        <SolidColorBrush x:Key="BorderColor" Color="#303946"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8995A5"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#35A875"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#43BD88"/>

        <!-- BUTTON -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#35A875"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#43BD88"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#247B55"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#354252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#43BD88"/>
            <Setter Property="SelectionBrush" Value="#286B51"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#35A875"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CHECKBOX -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#B7C1CF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- SECTION TITLE -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <!-- SECTION DESCRIPTION -->
        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8995A5"/>
        </Style>

        <!-- CARD -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E242D"/>
            <Setter Property="BorderBrush" Value="#303946"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="#CDD6E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#171D25"/>
            <Setter Property="AlternatingRowBackground" Value="#1B222C"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- DATAGRID ROW -->
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6E1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#254638"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DATAGRID CELL -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- LISTBOX -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#171D25"/>
            <Setter Property="Foreground" Value="#AEBBCB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5,7"/>
            <Setter Property="Foreground" Value="#AEBBCB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#252F3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#254638"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5.7*"/>
            <ColumnDefinition Width="2.3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================== -->
        <!-- LEFT TOP - INPUT -->
        <!-- ===================================== -->

        <Border Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,12,12">

            <StackPanel>

                <TextBlock Text="DESZYFROWANIE LOGÓW"
                           Style="{StaticResource SectionTitle}"
                           FontSize="16"/>

                <TextBlock Text="Wczytaj plik lub wklej zaszyfrowaną zawartość"
                           Style="{StaticResource SectionDescription}"
                           Margin="2,2,0,12"/>

                <!-- INPUT -->
                <TextBox x:Name="TextInputEditor"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         Height="65"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextChanged="OnTextChanged"/>

                <!-- ACTION BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">

                    <Button Content="Wybierz plik"
                            Click="OnChooseFileClicked"
                            Width="125"/>

                    <Button Content="Deszyfruj"
                            Click="OnDecryptFileClicked"
                            Width="125"
                            IsEnabled="False"
                            x:Name="ProcessButton"
                            Background="#247B55"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- ===================================== -->
        <!-- LEFT BOTTOM - DECODED LOGS -->
        <!-- ===================================== -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,12,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="2,0,2,12">

                    <StackPanel>
                        <TextBlock Text="ROZKODOWANE LOGI"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Podgląd odszyfrowanej zawartości"
                                   Style="{StaticResource SectionDescription}"/>
                    </StackPanel>

                </Grid>

                <!-- FILTERS -->
                <Border Grid.Row="1"
                        Background="#171D25"
                        BorderBrush="#303946"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="5"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="FILTRY"
                                   Foreground="#8995A5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="5,2,0,3"/>

                        <WrapPanel VerticalAlignment="Center">

                            <CheckBox Content="Logger"
                                      IsChecked="True"
                                      x:Name="FilterLoggerCheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                            <CheckBox Content="APDU"
                                      IsChecked="True"
                                      x:Name="FilterAPDUCheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                            <CheckBox Content="T.0"
                                      IsChecked="True"
                                      x:Name="FilterT0CheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                            <CheckBox Content="P.1.0"
                                      IsChecked="True"
                                      x:Name="FilterP1CheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                            <CheckBox Content="P.2.0"
                                      IsChecked="True"
                                      x:Name="FilterP2CheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                            <CheckBox Content="P.14.0"
                                      IsChecked="True"
                                      x:Name="FilterP14CheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                            <CheckBox Content="All"
                                      IsChecked="True"
                                      x:Name="FilterAllCheckBox"
                                      Checked="OnFilterChanged"
                                      Unchecked="OnFilterChanged"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>

                <!-- DECODED DATA -->
                <DataGrid x:Name="DataMessagesGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding FilteredMessages}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="None"
                          GridLinesVisibility="None"
                          AutoGenerateColumns="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Binding="{Binding}"
                                            Width="*"
                                            IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">

                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Top"/>

                                    <Setter Property="Margin"
                                            Value="9,6"/>

                                    <Setter Property="FontFamily"
                                            Value="Consolas"/>

                                    <Setter Property="FontSize"
                                            Value="11"/>

                                    <Setter Property="Foreground"
                                            Value="#C6D2E0"/>

                                </Style>
                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- ===================================== -->
        <!-- RIGHT - CODE GENERATOR + LOG MESSAGES -->
        <!-- ===================================== -->

        <Border Grid.RowSpan="2"
                Grid.Column="1"
                Style="{StaticResource CardBorder}"
                Padding="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CODE GENERATOR -->
                <StackPanel Grid.Row="0"
                            Margin="2,2,2,12">

                    <TextBlock Text="KOD DOSTĘPU"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Dynamiczny kod dostępu"
                               Style="{StaticResource SectionDescription}"
                               Margin="0,3,0,10"/>

                    <Border Background="#171D25"
                            BorderBrush="#354252"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4">

                        <TextBox x:Name="GeneratedCodeTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="35"
                                 IsReadOnly="True"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 FontSize="21"
                                 FontWeight="Bold"
                                 Foreground="#43BD88"
                                 Padding="3"/>

                    </Border>

                    <Grid Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Generuj kod"
                                Click="OnGenerateCodeClicked"
                                Margin="0,0,4,0"
                                Padding="8,8"/>

                        <Button Grid.Column="1"
                                Content="Kopiuj"
                                Click="OnCopyCodeClicked"
                                Background="#465568"
                                Margin="4,0,0,0"
                                Padding="8,8"/>

                    </Grid>

                </StackPanel>

                <!-- SEPARATOR + HEADER -->
                <StackPanel Grid.Row="1"
                            Margin="2,0,2,12">

                    <Border Height="1"
                            Background="#303946"
                            Margin="0,0,0,13"/>

                    <TextBlock Text="LOG MESSAGES"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Przebieg operacji i komunikaty"
                               Style="{StaticResource SectionDescription}"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <!-- LOG LIST -->
                <Border Grid.Row="2"
                        Background="#171D25"
                        BorderBrush="#303946"
                        BorderThickness="1"
                        CornerRadius="6">

                    <ListBox x:Name="LogListBox"
                             ItemsSource="{Binding LogMessages}"
                             Margin="3"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Foreground="#AEBBCB"
                                           FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Border>

                <!-- SAVE BUTTON -->
                <Button Grid.Row="3"
                        Content="Zapisz do pliku"
                        Click="OnSaveTextClicked"
                        HorizontalAlignment="Stretch"
                        Margin="0,12,0,0"
                        Padding="10,11"
                        Background="#247B55"/>

            </Grid>

        </Border>

    </Grid>

</Window>
